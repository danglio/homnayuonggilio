	<div class="btn back border p-0 d-flex align-items-center justify-content-center position-absolute">
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M15.989 5.41046L9.94862 12L15.989 18.5895C16.337 18.9691 16.337 19.5763 15.989 19.9559C15.6296 20.348 15.0371 20.348 14.6776 19.9559L8.01097 12.6832C7.66301 12.3036 7.66301 11.6964 8.01097 11.3168L14.6776 4.04408C15.0371 3.65197 15.6296 3.65197 15.989 4.04408C16.337 4.42368 16.337 5.03087 15.989 5.41046Z" fill="#ED1C24"/>
		</svg>
		Quay lại</div>
</div>
<script>
	$('.cart__voucher_view, .voucher-apply').click(function(){
		$('.voucher-fixed').addClass('active')
	})
	$('.cart-fixed .cart__header').click(function(){
		$('.cart-fixed').removeClass('active');
		$('body').removeClass('overflow');
		$('#body_overlay').addClass('d-none');
		$('.mobile_open_box_swatch').removeClass('active');
	})
	$('.voucher-fixed .cart__header, .voucher-fixed .back').click(function(){
		$('.voucher-fixed').removeClass('active');
	})
	$('.cart-total-detail-decrease .expand').click(function(){
		$('.cart-total-detail-decrease').removeClass('d-flex').addClass('d-none');
		$('.cart-total-detail-expand').removeClass('d-none');
		$('.cart-fixed').addClass('detail-expand')
	})
	$('.cart-total-detail-expand .decrease').click(function(){
		$('.cart-total-detail-decrease').addClass('d-flex').removeClass('d-none');
		$('.cart-total-detail-expand').addClass('d-none');
		$('.cart-fixed').removeClass('detail-expand')
	})
	function relatedProductSlide(){
		var swiperCartRelated = new Swiper('.cart__related .swiper-container', { 
			spaceBetween: 24,
			slidesPerView: 2.5,
			watchSlidesProgress: true,
			navigation: {
				nextEl: '.cart__related .swiper-button-next',
				prevEl: '.cart__related .swiper-button-prev',
			},
			breakpoints: {
				0: {
					slidesPerView: 2,
					spaceBetween: 12,
				},
				576: {
					slidesPerView:  2.5
				}
			}
		});
	}
	function initProductsRelated() {
		var cartData = {};
		$.ajax({
			url: "/cart?view=data",
			async : false,
			success: function(data){
				cartData = JSON.parse(data);
			}
		})
		var relatedPrefix = "muacung";
		var relatedTags = cartData.cart_tags.filter(function onlyUnique(value, index, self) {
			return self.indexOf(value) === index && value.indexOf(`${relatedPrefix.trim()}_`) >= 0
		})
		$.get(`/search?q= NOT id:(${cartData.cart_id.join(" OR ")}) AND tags:(${relatedTags.map(tag => `(${tag})`).join(" OR ")})&view=cart`).then(response => {
			if(response && response.length) {
				$('.cart__related .swiper-wrapper').html(response);
				$('.cart-fixed').find('.js-addToCart').on('click', addToCart);
				relatedProductSlide();
				$('.cart__related').addClass('active')
			} else {
				$('.cart__related').removeClass('active')
			}
		})
	}
	//initProductsRelated();
	function copyCode(code) {
		navigator.clipboard.writeText(code).then(() => {
			/*
			const message = document.getElementById(`message-${code}`);
			message.classList.add('show-message');
			setTimeout(() => {
				message.classList.remove('show-message');
			}, 2000);*/
			createToast('success', toastString.toastAddSuccessTitle, 'Đã sao chép mã giảm giá');
		});
	}
</script>		

		<script>
			$(document).on('click', '.apply-discount', function(e) {
				e.preventDefault();
				var $button = $(this);
				var code = $button.data('code');
				if (!code) {
					return;
				}
				$.post('/cart/update.js', {
					discount: code
				})
				.done(function(response) {
					$button.removeClass('loading').text('Đã áp dụng');
					$button.closest('.voucher-fixed .item').addClass('false');
					$.ajax({
						type: 'GET',
						url: '/cart.js',
						dataType: 'json',
						success: function(cart) {
							cartTotal.html(formatStoreCurrency.format(cart.total_price));
							var totalPromotion = Number(
								$('.cart__summary_total_compare').attr('data-price')
							) || 0;
							$.each(cart.cart_level_discount_applications || [], function(index, discount) {
								totalPromotion += Number(discount.total_allocated_amount) || 0;
							});
							$('.cart__summary_total_compare').text(
								formatStoreCurrency.format(totalPromotion)
							);
						},
						error: function(xhr, status, error) {
							console.log('STATUS:', xhr.status);
							console.log('ERROR:', error);
							console.log('RESPONSE:', xhr.responseText);
						}
					});
					$('.voucher-fixed').removeClass('active');
				})
				.fail(function(xhr) {
					console.log('Không áp dụng được mã giảm giá:', xhr.responseText);
					$button.removeClass('loading').text('Áp dụng');
				});
			});
			
			$(document).on('click', '.voucher-apply .remove-voucher', function(e) {
				e.preventDefault();
				var $button = $(this);
				var $currentVoucher = $button.closest('.voucher-code');
				var removedCode = $currentVoucher.data('code');
				var codes = [];
				$('.voucher-apply .voucher-code').each(function() {
					var code = $(this).data('code');
					if (code && code !== removedCode) {
						codes.push(code);
					}
				});
				var discount = codes.join(',');
				$.post('/cart/update.js', {
					discount: discount
				}).done(function(response) {
					console.log('Đã cập nhật mã giảm giá:', response);
					$currentVoucher.remove();
					var $voucherItem = $('.voucher-fixed .item[data-code="' + removedCode + '"]');
					$voucherItem.removeClass('false');
					$voucherItem.find('.apply-discount').text('Áp dụng');
					$.ajax({
						type: 'GET',
						url: '/cart.js',
						dataType: 'json',
						success: function(cart) {
							cartTotal.html(formatStoreCurrency.format(cart.total_price));
							var totalPromotion = Number(
								$('.cart__summary_total_compare').attr('data-price')
							) || 0;
							$.each(cart.cart_level_discount_applications || [], function(index, discount) {
								totalPromotion += Number(discount.total_allocated_amount) || 0;
							});
							$('.cart__summary_total_compare').text(
								formatStoreCurrency.format(totalPromotion)
							);
						},
						error: function(xhr, status, error) {
							console.log('STATUS:', xhr.status);
							console.log('ERROR:', error);
							console.log('RESPONSE:', xhr.responseText);
						}
					});
				}).fail(function(xhr) {
					console.log('Không cập nhật được mã giảm giá:', xhr.responseText);
				});
			});
		</script>
		
	</body>
</html>