</template><script>
	document.addEventListener('DOMContentLoaded', () => {
		let buyxgety = false;
		let selectedProductsBuyXGetY = [];
		let buynow = false;
		window.buyWithXGetY = function(variantId) {
			console.log(variantId);
			const $form = $('form').filter(function() {
				return String($(this).find('[name="variantId"]').val()) === String(variantId);
			});

			const checkedItems = [
				...$form.find(".gift-product input[type='checkbox']:checked")
			];

			const data = { updates: {} };

			fetch('/cart.js')
				.then(res => res.json())
				.then(cart => {
					checkedItems.forEach(item => {
						const variantId = Number(item.value);
						const giftQuantity = parseInt(
							$form.find('.custom-btn-number input').val(),
							10
						) || 0;

						const cartItem = cart.items.find(
							item => Number(item.variant_id) === variantId
						);

						const currentQuantity = cartItem ? cartItem.quantity : 0;

						data.updates[variantId] = currentQuantity + giftQuantity;
					});

					// GIỮ NGUYÊN PHẦN CART UPDATE CỦA BẠN
					return fetch("/cart/update.js", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify(data),
					});
				});

			// GIỮ NGUYÊN PHẦN CODE CART UPDATE THỨ 2 CỦA BẠN
			fetch("/cart/update.js", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify(data),
			}).then(function (res) {
				return res.json();
			}).then(function(res) {
				fetch("/cart.js", {
					headers: {
						"Content-Type": "application/json",
					},
				}).then(function (resCart) {
					return resCart.json();
				}).then(function(resCart) {
					const listItemChecked = [];

					for (const [index, lineItem] of resCart.items.entries()) {
						if (
							checkedItems.some(function(checkedItem) {
								return Number(checkedItem.value) === lineItem.variant_id;
							}) ||
							lineItem.variant_id === Number(variantId)
						) {
							listItemChecked.push({
								id: lineItem.id,
								line: index + 1,
								quantity: lineItem.quantity,
								price: lineItem.price,
								variant_id: lineItem.variant_id,
								fieldGiftBox: "",
								fieldColor: "",
								fieldGiftInfo: "",
							});
						}
					}

					window.localStorage.setItem(
						"line_items_checked",
						JSON.stringify(listItemChecked)
					);

					if (!buynow) {
						$(document).trigger('changeCart');
					}
				});
			});
		};
	});
</script>
