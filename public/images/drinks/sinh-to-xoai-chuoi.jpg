		<!-- Cookie Consent Banner -->
		<div id="cookieBanner" class="fixed-bottom bg-white border-top py-2">
			<div class="container">
				<div class="row align-items-center gy-3">
					<div class="col-lg-9">
						<div class="fw-bold mb-1">Elmich quan tâm đến quyền riêng tư của bạn</div>
						<p class="mb-0 small text-secondary">
							Chúng tôi sử dụng cookie để cải thiện trải nghiệm duyệt web, đo lường hiệu suất trang
							và hiển thị nội dung phù hợp với bạn
							<a href="/chinh-sach-bao-mat-thong-tin" class="text-decoration-underline">Chính sách Cookie</a>
						</p>
					</div>
					<div class="col-lg-3">
						<div class="d-flex gap-2 justify-content-center justify-content-lg-end pt-1" style=" gap: 20px; ">
							<button type="button" class="btn btn-decline" onclick="handleConsent('declined')">Từ chối</button>
							<button type="button" class="btn btn-accept" onclick="handleConsent('accepted')">Chấp nhận tất cả</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
			const CONSENT_KEY = 'elmich_cookie_consent';

			// Ẩn banner nếu người dùng đã chọn trước đó
			if (localStorage.getItem(CONSENT_KEY)) {
				document.getElementById('cookieBanner').style.display = 'none';
			}

			function handleConsent(value) {
				localStorage.setItem(CONSENT_KEY, value);
				document.getElementById('cookieBanner').style.display = 'none';
				// TODO: nếu accepted -> kích hoạt script tracking (GA, Pixel...)
			}
		</script>
		<style>
			#cookieBanner {
				box-shadow: 0 -2px 16px rgba(0, 0, 0, .08);
				z-index: 1080;
			}
			#cookieBanner .btn-accept {
				background-color: #111;
				color: #fff;
				border-radius: 8px;
				padding: 10px 24px;
				font-weight: 600;
			}
			#cookieBanner .btn-accept:hover { background-color: #333; }
			#cookieBanner .btn-decline {
				background-color: #fff;
				color: #111;
				border: 1px solid #d0d0d0;
				border-radius: 8px;
				padding: 10px 24px;
				font-weight: 600;
			}
			#cookieBanner .btn-decline:hover { border-color: #999; }
			#cookieBanner a { color: #005fcc; }
			@media (max-width: 991.98px) {
				#cookieBanner h6 { font-size: .9rem; }
				#cookieBanner p { font-size: .75rem; }
				#cookieBanner .btn-accept,
				#cookieBanner .btn-decline { font-size: .85rem; padding: 8px 20px; }
			}
		</style>
	</div>
